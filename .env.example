# --- P1 backend ---
NEXT_PUBLIC_CSS_SITE_ID=site-123
CSS_API_KEY=your-api-key

# Origin every login returns to. Unset, a login returns to the host it started
# on. A login completes only on the origin it started from, so a value shared by
# more than one host breaks logins on the others. If logins return to the wrong
# host, register the site's origins in the P1 dashboard.
# P1_SITE_URL=https://www.yoursite.com

# --- Public site URL (optional) ---
# Origin the site is served from, used to make metadata URLs absolute. Pages on a
# site with locales get hreflang links to their locale variants only when it is set.
# NEXT_PUBLIC_SITE_URL=https://www.yoursite.com

# --- P1 backend URL (optional) ---
# P1 backend defaults to https://ccr.p1.pantheon.io for production.
# Override for staging, local, or sandbox deployments:
# NEXT_PUBLIC_CSS_BASE_URL=https://staging.ccr.p1.pantheon.io

# --- P1 Admin Dashboard (optional) ---
# Override the default dashboard URL (https://content.pantheon.io)
# NEXT_PUBLIC_P1_ADMIN_DASHBOARD_URL=https://staging.content.pantheon.io

# Branch is auto-detected (defaults to main) unless specified:
# NEXT_PUBLIC_CSS_BRANCH_ID=branch-456

# --- AI chatbot (optional) ---
# Chat agent. Defaults to production (https://agent.p1.pantheon.io), so leave it
# unset unless this site talks to another environment — local dev, or a staging
# deployment. Set it alongside
# NEXT_PUBLIC_CSS_BASE_URL and NEXT_PUBLIC_MEDIA_WORKER_URL, not on its own — a
# site that overrides only the backend still reaches the production agent, and
# nothing reports the mismatch.
# NEXT_PUBLIC_AGENT_URL=http://localhost:8790

# --- Media library (on by default) ---
# Worker API base for the media library and for keeping chat attachments — both
# packages read this one variable, so they cannot point at different environments.
# Unset means different things to each: the library falls back to the production
# worker (https://pantheon-files.com), while chat keeps nothing, so attachments
# do not outlive the tab. Storing someone's files on a host nobody chose is worse
# than not storing them.
# NEXT_PUBLIC_MEDIA_WORKER_URL=http://localhost:8788

# CDN image origin used to validate media URLs — NOT the Worker API URL.
# Defaults to the production origin (https://pantheon-files.com). Override
# for staging or local dev.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://staging.media.p1.pantheon.io

# --- Content Publisher (optional) ---
# Add your secrets to connect to Content Publisher collections and
# automatically pull documents from there into your P1 site.
# PCC_SITE_ID=your-content-publisher-collection-id
# PCC_TOKEN=your-content-publisher-access-token

# =============================================================================
# Podcast site config. Nothing about a specific show is hardcoded: point these
# at your own show. A backend whose variables are unset is disabled.
# =============================================================================

# --- Episodes: which backend serves them ---
# auto (default): show.fm and WordPress merged (show.fm wins on overlap).
# showfm | wordpress force one.
# EPISODE_SOURCE=auto

# --- show.fm (server-side only; never NEXT_PUBLIC_) ---
# Unset = show.fm disabled. Note: an externally hosted show only has episodes
# created in show.fm in its API; the back catalogue stays in WordPress.
SHOWFM_PODCAST_SLUG=your-show-slug
# SHOWFM_API_BASE=https://api.show.fm/v1
# Scopes: podcasts:read, episodes:read, transcripts:read. Adds show notes HTML.
# SHOWFM_API_KEY=showfm_live_...

# --- WordPress (headless: episodes feed + REST + blog) ---
# Unset = WordPress disabled.
WP_BASE_URL=https://example.com
# Your PowerPress feed path (PowerPress's default is /feed/podcast/).
WP_FEED_PATH=/feed/podcast/
# If the site is behind Pantheon next-gen GCDN bot protection, unknown clients
# get a 403 managed challenge. Two ways through (use either):
#  1. Allowlist this app's User-Agent (preferred: nothing rotates). The match is
#     EXACT and case-sensitive, so the entry must equal WP_USER_AGENT:
#       terminus gcdn:ua-bypass:add <site>.<env> <hostname> "communitycode-p1/1.0"
#     WP_USER_AGENT defaults to that string; change both together.
# WP_USER_AGENT=communitycode-p1/1.0
#  2. A bypass token, sent as x-pantheon-bot-bypass. It ROTATES (about every 6
#     months, with the next one overlapping), so do not paste it into a file that
#     outlives it. Read the current value when you need it:
#       terminus gcdn:bot-bypass <site> --format=json   (the "current" row)
# PANTHEON_BOT_BYPASS_TOKEN=

# --- Transcripts ---
# Hosts server-side code may fetch transcript files from (SSRF guard). The
# WordPress host and, when show.fm is configured, show.fm's media CDN are allowed
# automatically. Add others here. Comma-separated, exact hostnames.
# TRANSCRIPT_ALLOWED_HOSTS=cdn.example-podcast-host.com

# --- Site identity (NEXT_PUBLIC_*: baked in at build; set site-wide) ---
NEXT_PUBLIC_SITE_NAME=Your Podcast
# NEXT_PUBLIC_SITE_TAGLINE=
# NEXT_PUBLIC_FEED_URL=https://example.com/feed/podcast/
# NEXT_PUBLIC_APPLE_PODCASTS_URL=
# JSON array: header/footer default links (editable per block in the editor).
# NEXT_PUBLIC_SITE_NAV=[{"label":"Episodes","href":"/episodes"}]

# --- Newsletter (server-only; see docs/newsletter-mailpoet.md) ---
# The endpoint your CMS exposes for subscribing (e.g. a WordPress REST route in
# front of MailPoet). Unset = POST /api/newsletter answers 501 "not configured".
# NEWSLETTER_ENDPOINT=https://example.com/wp-json/community-code/v1/newsletter
# NEWSLETTER_SECRET=

# --- Contact form (server-only; see docs/contact-wordpress.md) ---
# The endpoint your CMS exposes for receiving contact messages (e.g. a WordPress
# REST route that sends the mail). Unset = POST /api/contact answers 501 "not
# configured" and the form says it isn't available. Both must be set.
# CONTACT_ENDPOINT=https://example.com/wp-json/community-code/v1/contact
# Shared secret, sent as Authorization: Bearer <secret>. Never NEXT_PUBLIC_.
# Generate once: openssl rand -base64 32
# CONTACT_SECRET=
